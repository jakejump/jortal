// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String    @map("password_hash")
  role          String    @default("pending") // pending | member | admin
  createdAt     DateTime  @default(now()) @map("created_at")

  profile         Profile?
  pendingApproval PendingApproval?
  createdEvents   Event[]         @relation("EventAdmin")
  uploadedNewsletters Newsletter[] @relation("NewsletterAdmin")
  chatMessages   ChatMessage[]
}

model PendingApproval {
  id          String   @id @default(cuid())
  name        String
  classYear   Int      @map("class_year")
  email       String
  phone       String
  residence   String
  occupation  String
  submittedAt DateTime @default(now()) @map("submitted_at")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  id          String   @id @default(cuid())
  name        String
  classYear   Int      @map("class_year")
  residence   String
  occupation  String
  phone       String?  @map("phone")
  bio         String?
  photoUrl    String?  @map("photo_url")
  linkedinUrl String?  @map("linkedin_url")
  interests   String?
  socialLinks String?  @map("social_links") // JSON string: { twitter, instagram, etc. }
  updatedAt   DateTime @updatedAt @map("updated_at")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id          String   @id @default(cuid())
  title       String
  description String?
  eventDate   DateTime @map("event_date")
  location    String?

  adminId String @map("admin_id")
  admin   User   @relation("EventAdmin", fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
}

model Newsletter {
  id          String   @id @default(cuid())
  title       String
  fileUrl     String   @map("file_url")
  publishedAt DateTime @default(now()) @map("published_at")

  adminId String @map("admin_id")
  admin   User   @relation("NewsletterAdmin", fields: [adminId], references: [id], onDelete: Cascade)
}

model ChatMessage {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
